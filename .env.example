# IoT Logistics Pipeline Configuration
# Copy this file to .env (scripts/init.sh does this for you) and fill in the values.
# .env is gitignored - never commit real secrets.

# --- iot_database (TimescaleDB + PostGIS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_iot_demo_pass
POSTGRES_DB=iot_database

# Least-privilege application role used by Spark/dbt/Airflow connections
# (never the postgres superuser above).
PIPELINE_DB_USER=pipeline_rw
PIPELINE_DB_PASSWORD=change_me_pipeline_rw_pass

# --- Airflow metadata database (separate Postgres instance) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_pass
AIRFLOW_DB_NAME=airflow_metadata

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Must be identical across every Airflow component (scheduler signs the internal
# Execution API JWT with these, airflow-api-server verifies it) - generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- OpenWeatherMap (weather_enrichment_dag, §8) ---
# Sign up at https://openweathermap.org/api to obtain a free API key.
# Confirm current free-tier rate limits before relying on this in a long-running demo.
OPENWEATHERMAP_API_KEY=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_pass
